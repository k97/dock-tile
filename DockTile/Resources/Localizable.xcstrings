{
  "sourceLanguage": "en-GB",
  "strings": {
    "alert.applyPopover.message": {
      "comment": "Confirmation message warning the Dock will restart when applying popover settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile erstellt deine Kacheln im Dock mit dem neuen Popover-Design neu und startet das Dock kurz neu. Deine anderen Objekte im Dock bleiben unverändert."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile will rebuild your pinned tiles with the new popover look and briefly restart the Dock. Your other Dock items won't be affected."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile will rebuild your pinned tiles with the new popover look and briefly restart the Dock. Your other Dock items won't be affected."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile will rebuild your pinned tiles with the new popover look and briefly restart the Dock. Your other Dock items won't be affected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile va reconstruire vos tuiles du Dock avec le nouvel aspect de la fenêtre surgissante et redémarrer brièvement le Dock. Vos autres éléments du Dock ne seront pas modifiés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tileは、Dockにあるタイルを新しいポップオーバーの外観で再構築し、Dockを一時的に再起動します。Dock内のほかの項目には影響しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile пересоздаст закрепленные плитки с новым видом всплывающей панели и ненадолго перезапустит Dock. Другие объекты в Dock не изменятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile将使用新的弹出面板外观重建程序坞中的磁贴，并短暂重新启动程序坞。程序坞中的其他项目不受影响。"
          }
        }
      }
    },
    "alert.applyPopover.title": {
      "comment": "Confirmation title before rebuilding tiles to apply popover appearance settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf deine Kacheln im Dock anwenden?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply to your Dock tiles?"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply to your Dock tiles?"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply to your Dock tiles?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appliquer à vos tuiles du Dock ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dockのタイルに適用しますか?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Применить к плиткам в Dock?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要应用到程序坞中的磁贴吗？"
          }
        }
      }
    },
    "alert.configUnreadable.message": {
      "comment": "Launch alert message when the tile settings file can't be read; %@ = the file's full path. The app quits when the alert closes.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Kacheln wurden nicht geändert. Dock Tile konnte seine Einstellungsdatei nicht öffnen und wird beendet. Prüfe, ob du %@ öffnen kannst, und öffne Dock Tile dann erneut."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tiles haven't been changed. Dock Tile couldn't open its settings file and will quit. Check that you can open %@, then open Dock Tile again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tiles haven't been changed. Dock Tile couldn't open its settings file and will quit. Check that you can open %@, then open Dock Tile again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tiles haven't been changed. Dock Tile couldn't open its settings file and will quit. Check that you can open %@, then open Dock Tile again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos tuiles n’ont pas été modifiées. Dock Tile n’a pas pu ouvrir son fichier de réglages et va se fermer. Vérifiez que vous pouvez ouvrir %@, puis rouvrez Dock Tile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タイルは変更されていません。Dock Tileは設定ファイルを開けなかったため、終了します。%@を開けることを確認してから、もう一度Dock Tileを開いてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваши плитки не изменены. Dock Tile не удалось открыть файл настроек, поэтому программа завершит работу. Убедитесь, что вы можете открыть %@, затем снова откройте Dock Tile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的磁贴未被更改。Dock Tile无法打开其设置文件，将会退出。请确认你可以打开%@，然后再次打开Dock Tile。"
          }
        }
      }
    },
    "alert.configUnreadable.quit": {
      "comment": "Only button of the can't-read-tiles launch alert; quits Dock Tile",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beenden"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quitter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "退出"
          }
        }
      }
    },
    "alert.configUnreadable.title": {
      "comment": "Launch alert title: the tile settings file exists but could not be opened; the app quits after it",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile kann deine Kacheln nicht lesen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile Can't Read Your Tiles"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile Can't Read Your Tiles"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile Can't Read Your Tiles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile ne peut pas lire vos tuiles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tileがタイルを読み込めません"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile не может прочитать ваши плитки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile无法读取你的磁贴"
          }
        }
      }
    },
    "alert.deleteTile.message": {
      "comment": "Delete-tile confirmation message",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kachel wird endgültig gelöscht und aus dem Dock entfernt."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete the tile and remove it from the dock."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete the tile and remove it from the dock."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete the tile and remove it from the dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La tuile sera définitivement supprimée et retirée du Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このタイルは完全に削除され、Dockからも取り除かれます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Плитка будет удалена без возможности восстановления и исчезнет из Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作将永久删除该磁贴，并将其从程序坞中移除。"
          }
        }
      }
    },
    "alert.missingApps.message": {
      "comment": "Alert message offering to remove uninstalled apps from tiles",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einige Apps in deinen Kacheln wurden auf diesem Mac nicht gefunden. Aus deinen Kacheln entfernen?"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Some apps in your tiles can't be found on this Mac. Remove them from your tiles?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Some apps in your tiles can't be found on this Mac. Remove them from your tiles?"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Some apps in your tiles can't be found on this Mac. Remove them from your tiles?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certaines apps de vos tuiles sont introuvables sur ce Mac. Les retirer de vos tuiles ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タイル内の一部のアプリがこのMacで見つかりません。タイルから取り除きますか?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Некоторые приложения из ваших плиток не найдены на этом Mac. Удалить их из плиток?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的磁贴中有些App在这台Mac上找不到了。要将它们从磁贴中移除吗？"
          }
        }
      }
    },
