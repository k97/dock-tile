    "settings.dockLock.accessibilityNeededDetail": {
      "comment": "Explanation of why Accessibility access is needed",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile benötigt Zugriff auf Bedienungshilfen, um das Dock an seinem Platz zu halten. Aktiviere Dock Tile in den Systemeinstellungen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile needs Accessibility access to keep the Dock in place. Turn on Dock Tile in System Settings."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile needs Accessibility access to keep the Dock in place. Turn on Dock Tile in System Settings."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile needs Accessibility access to keep the Dock in place. Turn on Dock Tile in System Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile a besoin de l’accès Accessibilité pour garder le Dock en place. Activez Dock Tile dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dockを固定するには、Dock Tileにアクセシビリティへのアクセスを許可する必要があります。システム設定でDock Tileをオンにしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile нужен доступ к функциям универсального доступа, чтобы удерживать Dock на месте. Включите Dock Tile в Системных настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile需要无障碍访问权限才能固定程序坞的位置。请在“系统设置”中打开Dock Tile。"
          }
