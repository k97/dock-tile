    "settings.popover.footer": {
      "comment": "Explanatory footer under the popover settings form",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Einstellungen gelten für das Popover jeder Kachel. Die Liste zeigt immer Beschriftungen. Die Animation folgt deiner Systemeinstellung „Bewegung reduzieren“."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings apply to every tile's popover. List view always shows labels. Animation follows your system Reduce Motion setting."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings apply to every tile's popover. List view always shows labels. Animation follows your system Reduce Motion setting."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings apply to every tile's popover. List view always shows labels. Animation follows your system Reduce Motion setting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces réglages s’appliquent à la fenêtre surgissante de chaque tuile. La vue Liste affiche toujours les noms. L’animation suit le réglage système « Réduire les animations »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これらの設定はすべてのタイルのポップオーバーに適用されます。リスト表示では常にラベルが表示されます。アニメーションはシステムの“視差効果を減らす”設定に従います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эти настройки применяются к всплывающим панелям всех плиток. В виде списка подписи показываются всегда. Анимация учитывает системный параметр «Уменьшить движение»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这些设置适用于每个磁贴的弹出面板。列表视图始终显示标签。动画遵循系统的“减弱动态效果”设置。"
          }
        }
      }
    },
    "settings.popover.reduceMotion": {
      "comment": "Caption shown under Animation when the system Reduce Motion setting forces it off",
