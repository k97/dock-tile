    "translation.invite.message": {
      "comment": "One-time alert message inviting translation review",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Übersetzung wurde maschinell erstellt und noch nicht muttersprachlich geprüft. Wenn etwas falsch klingt, kannst du es auf GitHub korrigieren – ganz ohne Programmierkenntnisse."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This translation was made by a machine and has not yet been checked by a native speaker. If something reads wrong, you can fix it on GitHub — no coding needed."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This translation was made by a machine and has not yet been checked by a native speaker. If something reads wrong, you can fix it on GitHub — no coding needed."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This translation was made by a machine and has not yet been checked by a native speaker. If something reads wrong, you can fix it on GitHub — no coding needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette traduction a été réalisée automatiquement et n’a pas encore été vérifiée par une personne de langue maternelle française. Si quelque chose vous semble incorrect, vous pouvez le corriger sur GitHub — sans aucune connaissance en programmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この翻訳は機械翻訳によるもので、ネイティブスピーカーによる確認はまだ行われていません。おかしな表現があれば、GitHubで修正できます。コーディングは不要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот перевод выполнен машиной и еще не проверен носителем языка. Если что-то звучит неправильно, вы можете исправить это на GitHub — программировать не нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此翻译由机器生成，尚未经过母语人士校对。如果有读起来不对的地方，你可以在GitHub上修改——无需编程。"
          }
        }
      }
    },
