    "settings.dockLock.singleDisplay": {
      "comment": "Note shown when only one display is connected",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schließe einen zweiten Bildschirm an, um die Dock-Sperre zu verwenden. Mit nur einem Bildschirm bleibt das Dock genau dort, wo macOS es platziert."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a second display to use Dock Lock. With one screen the Dock stays exactly where macOS puts it."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a second display to use Dock Lock. With one screen the Dock stays exactly where macOS puts it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a second display to use Dock Lock. With one screen the Dock stays exactly where macOS puts it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez un deuxième écran pour utiliser le verrouillage du Dock. Avec un seul écran, le Dock reste exactement là où macOS le place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dockロックを使用するには、2台目のディスプレイを接続してください。画面が1つの場合、DockはmacOSが配置した場所に留まります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы использовать закрепление Dock, подключите второй дисплей. С одним экраном Dock остается там, где его размещает macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接第二台显示器即可使用“程序坞锁定”。只有一个屏幕时，程序坞会停留在macOS放置的位置。"
          }
        }
      }
    },
