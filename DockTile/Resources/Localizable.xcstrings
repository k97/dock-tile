    "about.diagnosticsBody": {
      "comment": "About: Copy Diagnostics row description.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Protokoll dessen, was die App und ihre Kacheln getan haben. Hänge es an eine E-Mail an, wenn etwas nicht stimmt – es enthält nichts Persönliches."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A log of what the app and its tiles did. Attach it to an email when something looks wrong — it contains nothing personal."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A log of what the app and its tiles did. Attach it to an email when something looks wrong — it contains nothing personal."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A log of what the app and its tiles did. Attach it to an email when something looks wrong — it contains nothing personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un journal de ce qu’ont fait l’app et ses tuiles. Joignez-le à un e-mail si quelque chose semble anormal — il ne contient rien de personnel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アプリとそのタイルの動作ログです。問題が起きたときはメールに添付してください。個人情報は含まれません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Журнал действий программы и ее плиток. Приложите его к письму, если что-то работает не так, — личных данных в нем нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "记录App及其磁贴所执行操作的日志。出现异常时，可将其附加到电子邮件中——其中不含任何个人信息。"
          }
        }
      }
    },
