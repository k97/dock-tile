    "about.feedbackBody": {
      "comment": "About: feedback card body",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Feedback geht direkt an den Entwickler. Die Diagnose enthält ein Protokoll dessen, was die App und ihre Kacheln getan haben – nichts Persönliches."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback goes straight to the developer. Diagnostics attach a log of what the app and its tiles did — nothing personal."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback goes straight to the developer. Diagnostics attach a log of what the app and its tiles did — nothing personal."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback goes straight to the developer. Diagnostics attach a log of what the app and its tiles did — nothing personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos commentaires sont envoyés directement au développeur. Les diagnostics joignent un journal de ce qu’ont fait l’app et ses tuiles — rien de personnel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フィードバックは開発者に直接届きます。診断情報として、アプリとそのタイルの動作ログが添付されます。個人情報は含まれません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отзывы попадают напрямую к разработчику. К диагностике прилагается журнал действий программы и ее плиток — без личных данных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "反馈会直接发送给开发者。诊断信息会附上App及其磁贴的操作日志，不含任何个人信息。"
          }
        }
      }
    },
