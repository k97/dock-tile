    "alert.restartDock.message": {
      "comment": "Alert message explaining Dock restart",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile startet das Dock neu, um Änderungen anzuwenden. Das passiert jedes Mal, wenn du Kacheln hinzufügst, aktualisierst oder entfernst. Deine aktuellen Objekte im Dock bleiben unverändert."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile restarts the Dock to apply changes. This happens whenever you add, update, or remove tiles. Your current Dock items won't be affected."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile restarts the Dock to apply changes. This happens whenever you add, update, or remove tiles. Your current Dock items won't be affected."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile restarts the Dock to apply changes. This happens whenever you add, update, or remove tiles. Your current Dock items won't be affected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile redémarre le Dock pour appliquer les modifications. Cela se produit chaque fois que vous ajoutez, mettez à jour ou supprimez des tuiles. Vos éléments du Dock actuels ne seront pas modifiés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tileは変更を適用するためにDockを再起動します。これはタイルを追加、更新、または削除するたびに行われます。現在のDockの項目には影響しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы применить изменения, Dock Tile перезапускает Dock. Это происходит каждый раз, когда вы добавляете, обновляете или удаляете плитки. Текущие объекты в Dock не изменятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile会重新启动程序坞以应用更改。每次添加、更新或移除磁贴时都会如此。程序坞中现有的项目不受影响。"
          }
        }
      }
    },
