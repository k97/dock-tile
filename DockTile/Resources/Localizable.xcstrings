    "empty.createFirstTileDescription": {
      "comment": "Zero-tiles description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fasse Apps und Ordner hinter einem Symbol im Dock zusammen. Beginne mit einer leeren Kachel oder mit einem Vorschlag auf Basis der Apps, die du nutzt."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Group apps and folders behind one Dock icon. Start blank, or from a tile suggested from the apps you use."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Group apps and folders behind one Dock icon. Start blank, or from a tile suggested from the apps you use."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Group apps and folders behind one Dock icon. Start blank, or from a tile suggested from the apps you use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Regroupez des apps et des dossiers derrière une seule icône du Dock. Partez de zéro ou d’une tuile suggérée d’après les apps que vous utilisez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アプリやフォルダを1つのDockアイコンにまとめましょう。空のタイルから始めることも、使用しているアプリから提案されたタイルから始めることもできます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Объедините приложения и папки под одним значком в Dock. Начните с пустой плитки или с плитки, предложенной на основе ваших приложений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将App和文件夹归入一个程序坞图标。可以从空白开始，也可以从根据你常用App推荐的磁贴开始。"
          }
        }
      }
    },
