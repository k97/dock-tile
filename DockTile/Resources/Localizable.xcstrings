    "settings.dockLock.description": {
      "comment": "Explanation under the Dock Lock toggle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verhindert, dass das Dock bei mehreren Bildschirmen zwischen ihnen springt. Es bleibt auf dem Bildschirm, den du auswählst."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the Dock from jumping between screens on multi-display setups. It stays on the display you choose."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the Dock from jumping between screens on multi-display setups. It stays on the display you choose."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the Dock from jumping between screens on multi-display setups. It stays on the display you choose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empêchez le Dock de passer d’un écran à l’autre lorsque vous utilisez plusieurs écrans. Il reste sur l’écran de votre choix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マルチディスプレイ環境で、Dockが画面間を移動しないようにします。Dockは選択したディスプレイに留まります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не дает Dock перескакивать между экранами, если подключено несколько дисплеев. Dock остается на выбранном дисплее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "防止程序坞在多显示器环境下于屏幕之间跳动。它会停留在你选择的显示器上。"
          }
        }
      }
    },
