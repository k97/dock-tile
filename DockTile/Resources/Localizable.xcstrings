    "error.appTranslocated": {
      "comment": "Error when the app is translocated and cannot generate helper bundles",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile wird von einem temporären, schreibgeschützten Ort aus ausgeführt und kann keine Kacheln erstellen. Verschiebe die App in deinen Ordner „Programme“ und versuche es erneut."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile is running from a temporary, read-only location and can't create tiles. Move it to your Applications folder and try again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile is running from a temporary, read-only location and can't create tiles. Move it to your Applications folder and try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile is running from a temporary, read-only location and can't create tiles. Move it to your Applications folder and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile s’exécute depuis un emplacement temporaire en lecture seule et ne peut pas créer de tuiles. Déplacez-le dans votre dossier Applications, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tileは一時的な読み出し専用の場所から実行されているため、タイルを作成できません。“アプリケーション”フォルダに移動してから、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Программа Dock Tile запущена из временного расположения, доступного только для чтения, и не может создавать плитки. Переместите ее в папку «Программы» и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile正从临时的只读位置运行，无法创建磁贴。请将它移到“应用程序”文件夹，然后重试。"
          }
        }
      }
    },
    "error.bundleBuildInProgress": {
      "comment": "Error when a second build is requested for a tile whose helper bundle is already being built",
