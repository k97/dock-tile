    "settings.dockLock.primer.reassurance": {
      "comment": "Reassurance line in the permission primer about what happens next",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als Nächstes bittet dich macOS, Dock Tile in den Systemeinstellungen zu aktivieren. Du kannst das jederzeit wieder deaktivieren."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, macOS will ask you to turn on Dock Tile in System Settings. You can turn this off any time."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, macOS will ask you to turn on Dock Tile in System Settings. You can turn this off any time."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, macOS will ask you to turn on Dock Tile in System Settings. You can turn this off any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS vous demandera ensuite d’activer Dock Tile dans Réglages Système. Vous pourrez le désactiver à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "次に、システム設定でDock Tileをオンにするよう、macOSから求められます。この設定はいつでもオフにできます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Затем macOS попросит включить Dock Tile в Системных настройках. Это можно отключить в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接下来，macOS会请你在“系统设置”中打开Dock Tile。你可以随时关闭此功能。"
          }
        }
      }
    },
