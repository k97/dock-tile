    "alert.relocate.blockingMessage": {
      "comment": "Message shown when a tile action is blocked because the app is translocated",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile kann diese Kachel nicht erstellen oder aktualisieren, weil die App von einem temporären, schreibgeschützten Ort aus ausgeführt wird. Das passiert, wenn sie aus dem Ordner „Downloads“ geöffnet wird. Verschiebe Dock Tile in deinen Ordner „Programme“ und versuche es erneut."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile can't create or update this tile because it's running from a temporary, read-only location. This happens when the app is launched from Downloads. Move Dock Tile to your Applications folder and try again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile can't create or update this tile because it's running from a temporary, read-only location. This happens when the app is launched from Downloads. Move Dock Tile to your Applications folder and try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile can't create or update this tile because it's running from a temporary, read-only location. This happens when the app is launched from Downloads. Move Dock Tile to your Applications folder and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile ne peut pas créer ni mettre à jour cette tuile, car il s’exécute depuis un emplacement temporaire en lecture seule. Cela se produit lorsque l’app est ouverte depuis le dossier Téléchargements. Déplacez Dock Tile dans votre dossier Applications, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tileは一時的な読み出し専用の場所から実行されているため、このタイルを作成または更新できません。これは、アプリを“ダウンロード”フォルダから起動したときに起こります。Dock Tileを“アプリケーション”フォルダに移動してから、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile не может создать или обновить эту плитку, так как программа запущена из временного расположения, доступного только для чтения. Так бывает, если открыть ее из папки «Загрузки». Переместите Dock Tile в папку «Программы» и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile无法创建或更新此磁贴，因为它正从一个临时的只读位置运行。从“下载”文件夹打开App时会出现这种情况。请将Dock Tile移到“应用程序”文件夹，然后重试。"
          }
        }
      }
    },
    "alert.relocate.checkbox": {
      "comment": "Checkbox to suppress future move-to-Applications nudges",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht erneut fragen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask again"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask again"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne plus demander"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今後確認しない"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Больше не спрашивать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不再询问"
          }
        }
      }
    },
    "alert.relocate.message": {
      "comment": "Message of the launch-time nudge to move the app to Applications",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile wird außerhalb deines Ordners „Programme“ ausgeführt. macOS führt die App dann möglicherweise von einem temporären, schreibgeschützten Ort aus, wodurch keine neuen Kacheln erstellt werden können. Verschiebe sie in den Ordner „Programme“, damit alles funktioniert."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile is running from outside your Applications folder. macOS may run it from a temporary, read-only location, which can stop new tiles from being created. Move it to Applications to make sure everything works."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile is running from outside your Applications folder. macOS may run it from a temporary, read-only location, which can stop new tiles from being created. Move it to Applications to make sure everything works."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Tile is running from outside your Applications folder. macOS may run it from a temporary, read-only location, which can stop new tiles from being created. Move it to Applications to make sure everything works."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile s’exécute en dehors de votre dossier Applications. macOS peut l’exécuter depuis un emplacement temporaire en lecture seule, ce qui peut empêcher la création de nouvelles tuiles. Déplacez-le dans Applications pour que tout fonctionne correctement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tileは“アプリケーション”フォルダ以外の場所から実行されています。macOSが一時的な読み出し専用の場所からアプリを実行することがあり、その場合は新しいタイルを作成できなくなる可能性があります。すべてが正しく動作するように、“アプリケーション”フォルダに移動してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Программа Dock Tile запущена не из папки «Программы». macOS может запускать ее из временного расположения, доступного только для чтения, и тогда новые плитки не удастся создать. Переместите ее в папку «Программы», чтобы все работало."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dock Tile正在“应用程序”文件夹之外运行。macOS可能会从临时的只读位置运行它，导致无法创建新磁贴。请将它移到“应用程序”文件夹，以确保一切正常。"
          }
        }
      }
    },
    "alert.relocate.title": {
      "comment": "Title of the prompt asking the user to move the app into the Applications folder",
