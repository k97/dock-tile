    "settings.dockLock.note": {
      "comment": "Footnote describing Dock Lock behaviour and trade-off",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Funktioniert mit dem Dock unten, links oder rechts. Ist es auf einem Bildschirm fixiert, werden auf deinen anderen Bildschirmen an diesem Rand ein paar Pixel reserviert."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with the Dock at the bottom, left, or right. Keeping it on a screen reserves a few pixels at that edge on your other displays."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with the Dock at the bottom, left, or right. Keeping it on a screen reserves a few pixels at that edge on your other displays."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with the Dock at the bottom, left, or right. Keeping it on a screen reserves a few pixels at that edge on your other displays."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fonctionne avec le Dock en bas, à gauche ou à droite. Le garder sur un écran réserve quelques pixels sur ce bord de vos autres écrans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dockが下、左、右のどの位置にあっても機能します。Dockを1つの画面に固定すると、ほかのディスプレイのその端で数ピクセルが確保されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Работает, когда Dock находится внизу, слева или справа. Чтобы удерживать Dock на одном экране, у того же края на других дисплеях резервируется несколько пикселей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "适用于位于底部、左侧或右侧的程序坞。将程序坞保持在一个屏幕上时，其他显示器的对应边缘会预留几个像素。"
          }
        }
      }
    },
