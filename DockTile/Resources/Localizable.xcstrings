    "smartAdd.noSuggestions": {
      "comment": "Add a Tile: empty suggestions note",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Vorschläge – Dock Tile lernt aus den Apps, die du öffnest. Du kannst das unter „Allgemein“ deaktivieren."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "No suggestions yet — Dock Tile learns from the apps you open. You can turn this off in General."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No suggestions yet — Dock Tile learns from the apps you open. You can turn this off in General."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "No suggestions yet — Dock Tile learns from the apps you open. You can turn this off in General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune suggestion pour l’instant — Dock Tile apprend des apps que vous ouvrez. Vous pouvez désactiver cette option dans Général."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まだ提案はありません。Dock Tileは開いたアプリから学習します。この機能は“一般”でオフにできます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пока нет предложений — Dock Tile учится на приложениях, которые вы открываете. Это можно отключить в разделе «Основные»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暂无建议——Dock Tile会从你打开的App中学习。你可以在“通用”中关闭此功能。"
          }
        }
      }
    },
