    "settings.dockLock.moveFailed": {
      "comment": "Error shown when the Dock could not be relocated",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Dock konnte nicht auf %@ bewegt werden. Stelle sicher, dass dieser Bildschirm nicht gespiegelt wird, und versuche es erneut."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't move the Dock to %@. Make sure that display isn't mirrored, then try again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't move the Dock to %@. Make sure that display isn't mirrored, then try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't move the Dock to %@. Make sure that display isn't mirrored, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de déplacer le Dock vers %@. Assurez-vous que cet écran n’est pas en recopie vidéo, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dockを%@に移動できませんでした。そのディスプレイがミラーリングされていないことを確認してから、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось переместить Dock на дисплей %@. Убедитесь, что для этого дисплея не включен видеоповтор, и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法将程序坞移到%@。请确认该显示器未设为镜像，然后重试。"
          }
        }
      }
    },
