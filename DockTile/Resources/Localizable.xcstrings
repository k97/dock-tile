    "settings.dockLock.primer.body": {
      "comment": "Explanation in the permission primer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Dock-Sperre hält das Dock auf dem Bildschirm, den du auswählst. Dazu benötigt Dock Tile Zugriff auf Bedienungshilfen, damit macOS das Dock nicht auf deine anderen Bildschirme verschiebt."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Lock keeps the Dock on the display you choose. To do that, Dock Tile needs Accessibility access so it can stop macOS from moving the Dock to your other screens."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Lock keeps the Dock on the display you choose. To do that, Dock Tile needs Accessibility access so it can stop macOS from moving the Dock to your other screens."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Lock keeps the Dock on the display you choose. To do that, Dock Tile needs Accessibility access so it can stop macOS from moving the Dock to your other screens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le verrouillage du Dock garde le Dock sur l’écran de votre choix. Pour cela, Dock Tile a besoin de l’accès Accessibilité afin d’empêcher macOS de déplacer le Dock vers vos autres écrans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dockロックは、Dockを選択したディスプレイに留めます。macOSがDockをほかの画面に移動しないようにするため、Dock Tileにはアクセシビリティへのアクセスが必要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закрепление Dock удерживает Dock на выбранном дисплее. Для этого Dock Tile нужен доступ к функциям универсального доступа, чтобы не давать macOS перемещать Dock на другие экраны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“程序坞锁定”会让程序坞停留在你选择的显示器上。为此，Dock Tile需要无障碍访问权限，以阻止macOS将程序坞移到其他屏幕。"
          }
        }
      }
    },
