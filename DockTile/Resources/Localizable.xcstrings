    "smartAdd.provenanceBanner": {
      "comment": "Banner shown atop Tile Detail when a tile was just created by Smart Add",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Von Smart Add aus deinen zuletzt verwendeten Apps erstellt. Benenne sie um, ändere ihr Aussehen oder die Apps – und füge sie dann deinem Dock hinzu."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Created by Smart Add from your recent apps. Rename it, restyle it or edit the apps — then add it to your Dock."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Created by Smart Add from your recent apps. Rename it, restyle it or edit the apps — then add it to your Dock."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Created by Smart Add from your recent apps. Rename it, restyle it or edit the apps — then add it to your Dock."
